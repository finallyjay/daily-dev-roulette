---
import Layout from "../layouts/Layout.astro";
import { currentUser } from "../lib/auth";
import { oauthEnabled } from "../lib/oauth";

const profile = await currentUser(Astro.cookies);
const oauth = oauthEnabled();
// With OAuth on, the personal-token form tucks into a <details> as a fallback.
const TokenWrap = oauth ? "details" : "div";

// ?login=<reason> is set by /api/auth/callback when "Sign in with daily.dev" doesn't pan out.
const LOGIN_ERRORS: Record<string, string> = {
  denied: "You turned daily.dev down. No hard feelings, partner.",
  failed: "Sign-in with daily.dev misfired. Give it another shot.",
  unavailable: "Sign in with daily.dev isn't saddled up here. Use an API token instead.",
};
const loginError = LOGIN_ERRORS[Astro.url.searchParams.get("login") ?? ""] ?? "";
---

<Layout title="daily.dev Roulette" profile={profile}>
  <div class="reveal r1 text-center">
    <p class="kicker">★ ★ ★ &nbsp; THE TERRITORY OF &nbsp; ★ ★ ★</p>
    <h1>daily.dev Roulette</h1>
    <p class="tagline">Round up your forgotten bookmarks. Read 'em or bury 'em.</p>
  </div>

  {!profile && (
    <section class="panel reveal r2 mb-[1.4rem]">
      <h2>Show your papers</h2>
      {oauth && (
        <>
          <p class="card-meta">Ride with your real bookmarks. daily.dev hands us the keys, and they stay in a sealed saddlebag — a secure cookie, only for your session.</p>
          <a href="/api/auth/login" class="btn-primary block no-underline text-center" id="oauth-signin">Sign in with daily.dev</a>
        </>
      )}
      <TokenWrap class="token-form">
        {oauth && <summary class="card-meta">Rather paste an API token?</summary>}
        <p class="card-meta">Paste your daily.dev API token (<a href="https://app.daily.dev/settings/api" target="_blank" rel="noopener">Settings → API</a>, no Plus subscription needed) to ride with your real bookmarks. It stays in a sealed saddlebag — a secure cookie, only for your session.</p>
        <label for="token" class="sr-only">daily.dev API token</label>
        <input type="password" id="token" placeholder="daily.dev API token" autocomplete="off" />
        <button class={oauth ? "btn-ghost w-full" : "btn-primary"} id="signin">Sign in</button>
      </TokenWrap>
      <p class="error" id="login-error" role="alert" aria-live="assertive">{loginError}</p>
    </section>
  )}

  {profile && (
    <p class="tagline reveal r2 -mt-4">Well howdy, {profile.name || profile.username || "stranger"}.</p>
  )}

  <section class="panel reveal r3">
    <h2 class="mb-4">Choose your duel</h2>

    <div class="mode-card">
      <span class="mode-stamp">NEW</span>
      <div class="mode-head">
        <span class="mode-icon">🔖</span>
        <div>
          <div class="mode-title">Bookmarks Roulette</div>
          <div class="card-meta">Spin a bookmark. Pardon it, or shoot it dead.</div>
        </div>
      </div>
      {profile && (
        <p class="card-meta mt-[0.6rem]">There's <b id="bm-count">…</b> in the chamber, partner.</p>
      )}
      <div class="row mt-[0.9rem]">
        {profile && (
          <a href="/roulette" class="btn-primary flex-1 no-underline text-center">🤠 Draw</a>
        )}
        <a href="/roulette?demo=1" class="btn-ghost w-full flex-1 no-underline text-center">▶ Demo</a>
      </div>
    </div>

    <p class="coming">— more duels comin' to town —</p>
  </section>
</Layout>

<script>
  // Back from /api/auth/callback: a fresh sign-in starts with a fresh game,
  // same as the token flow below. Drop ?login= so a reload doesn't repeat it.
  const login = new URL(location.href).searchParams.get("login");
  if (login) {
    if (login === "ok") {
      try { localStorage.removeItem("ddr_progress"); } catch {}
    }
    history.replaceState(null, "", "/");
  }

  const signin = document.getElementById("signin");
  signin?.addEventListener("click", async () => {
    const token = (document.getElementById("token") as HTMLInputElement).value.trim();
    const err = document.getElementById("login-error")!;
    err.textContent = "";
    if (!token) { err.textContent = "Paste a token first, partner."; return; }
    (signin as HTMLButtonElement).disabled = true;
    try {
      const res = await fetch("/api/auth", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ token }),
      });
      if (!res.ok) throw new Error((await res.json()).error || "Sign-in failed");
      try { localStorage.removeItem("ddr_progress"); } catch {}
      window.location.href = "/";
    } catch (e: any) {
      err.textContent = String(e.message || e);
      (signin as HTMLButtonElement).disabled = false;
    }
  });

  const countEl = document.getElementById("bm-count");
  if (countEl) {
    // Lightweight count endpoint: one daily.dev call, not a full paginated load.
    fetch("/api/bookmarks/count")
      .then((r) => {
        if (!r.ok) throw new Error(`count failed: ${r.status}`);
        return r.json();
      })
      .then((d) => {
        const n = d.count ?? 0;
        countEl.textContent = d.exact ? String(n) : `${n}+`;
      })
      .catch(() => { countEl.textContent = "?"; });
  }
</script>

<style>
  .kicker {
    font-family: var(--font-type);
    letter-spacing: 0.35em;
    font-size: 0.7rem;
    color: var(--brass);
    margin: 0 0 0.4rem;
  }
  .mode-card {
    position: relative;
    border: 2px solid var(--ink);
    border-radius: 3px;
    padding: 1.2rem;
    background: repeating-linear-gradient(45deg, rgba(0,0,0,0.015) 0 8px, transparent 8px 16px), #f1e6c9;
    box-shadow: 0 3px 0 rgba(0,0,0,0.25);
  }
  .mode-head { display: flex; gap: 0.9rem; align-items: center; }
  .mode-icon { font-size: 2rem; }
  .mode-title { font-family: var(--font-display); font-size: 1.25rem; color: var(--ink); }
  .mode-stamp {
    position: absolute; top: -12px; right: 14px;
    font-family: var(--font-display); font-size: 0.7rem;
    color: var(--blood); border: 2px solid var(--blood);
    padding: 2px 8px; border-radius: 3px; transform: rotate(7deg);
    background: #f1e6c9; letter-spacing: 0.1em;
  }
  details.token-form { margin-top: 1rem; }
  details.token-form summary { cursor: pointer; }
  .coming {
    text-align: center; font-family: var(--font-type);
    color: var(--ink-soft); font-size: 0.8rem; margin: 1.3rem 0 0;
  }

  /* staggered entrance */
  .reveal { animation: rise 0.7s cubic-bezier(0.16,1,0.3,1) both; }
  .r1 { animation-delay: 0.05s; }
  .r2 { animation-delay: 0.2s; }
  .r3 { animation-delay: 0.35s; }
  @keyframes rise {
    from { opacity: 0; transform: translateY(22px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
