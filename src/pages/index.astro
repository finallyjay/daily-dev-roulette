---
import Layout from "../layouts/Layout.astro";
import { currentUser } from "../lib/auth";
import { oauthEnabled } from "../lib/oauth";

const profile = await currentUser(Astro.cookies);
const oauth = oauthEnabled();
// Personal tokens are a local-dev convenience only (OAuth can't complete on
// localhost): the deployed app never asks for one, so they never pass through
// a hosted server. With OAuth on, the form tucks into a <details>.
const tokenSignin = import.meta.env.DEV;
const TokenWrap = oauth ? "details" : "div";

// ?login=<reason> is set by /api/auth/callback when "Sign in with daily.dev" doesn't pan out.
const LOGIN_ERRORS: Record<string, string> = {
  denied: "You turned daily.dev down. No hard feelings, partner.",
  failed: "Sign-in with daily.dev misfired. Give it another shot.",
  unavailable: "Sign in with daily.dev isn't saddled up here. Try the Demo instead.",
};
const loginError = LOGIN_ERRORS[Astro.url.searchParams.get("login") ?? ""] ?? "";
const name = profile?.name || profile?.username || "stranger";
---

<Layout title="daily.dev Roulette" profile={profile}>
  <div class="reveal r1 text-center">
    <p class="kicker">★ ★ ★ &nbsp; THE TERRITORY OF &nbsp; ★ ★ ★</p>
    <h1>daily.dev Roulette</h1>
    <p class="tagline">
      {profile ? <>Well howdy, {name}. The outlaws are restless.</> : "Round up your forgotten bookmarks. Read 'em or bury 'em."}
    </p>
  </div>

  <!-- The hub is a bounty poster nailed to the wall: same WANTED language as
       the verdict card in the game, so the home already shows how it plays. -->
  <section class="notice reveal r2" aria-labelledby="notice-title">
    <span class="nail tl" aria-hidden="true"></span>
    <span class="nail tr" aria-hidden="true"></span>
    <span class="nail bl" aria-hidden="true"></span>
    <span class="nail br" aria-hidden="true"></span>

    <p class="notice-top" id="notice-title">WANTED</p>
    <p class="notice-rule">— dead or read —</p>

    <div class="mini-cylinder" aria-hidden="true">
      <span class="h" style="--i:0"></span><span class="h" style="--i:1"></span>
      <span class="h" style="--i:2"></span><span class="h" style="--i:3"></span>
      <span class="h" style="--i:4"></span><span class="h" style="--i:5"></span>
      <span class="hub"></span>
    </div>

    {profile ? (
      <>
        <p class="bounty">
          <b id="bm-count">…</b>
          <span>outlaws loose in your bookmarks</span>
        </p>
        <a href="/roulette" class="btn-primary draw no-underline text-center">🤠 Draw</a>
        <p class="alt">
          or <a href="/roulette?demo=1">▶ warm up in the Demo</a> — fake bookmarks, nothing deleted
        </p>
      </>
    ) : (
      <>
        <h2 class="mode-name">Bookmarks Roulette</h2>
        <p class="pitch">
          Every link you saved "for later" and never opened. Spin the cylinder and one comes up:{" "}
          <b>spare it</b> and go read it, or <b>pull the trigger</b> and it's gone from daily.dev. For good.
        </p>

        <ol class="steps">
          <li><span>I</span>Spin</li>
          <li><span>II</span>Face the outlaw</li>
          <li><span>III</span>Read 'em or bury 'em</li>
        </ol>

        <div class="ledger">
          {oauth && (
            <>
              <p class="ledger-label">Sign the sheriff's ledger</p>
              <a href="/api/auth/login" class="official-signin" id="oauth-signin">
                <img src="/brand/daily-dev-signin-black-rounded.svg" alt="Sign in with daily.dev" width="205" height="40" />
              </a>
              <p class="fine">No Plus needed. Your keys ride in a secure cookie for this session; we keep nothing.</p>
            </>
          )}
          {tokenSignin && (
            <TokenWrap class="token-form">
              {oauth && <summary class="fine">Rather paste an API token?</summary>}
              <p class="fine">
                Paste your daily.dev API token (<a href="https://app.daily.dev/settings/api" target="_blank" rel="noopener">Settings → API</a>).
                It stays in a secure cookie, only for your session.
              </p>
              <label for="token" class="sr-only">daily.dev API token</label>
              <input type="password" id="token" placeholder="daily.dev API token" autocomplete="off" />
              <button class={oauth ? "btn-ghost w-full" : "btn-primary"} id="signin">Sign in</button>
            </TokenWrap>
          )}
          <p class="error" id="login-error" role="alert" aria-live="assertive">{loginError}</p>
        </div>

        <a href="/roulette?demo=1" class="demo-link">
          <span class="demo-title">▶ Try the Demo</span>
          <span class="demo-sub">No account. Fake bookmarks. Real gunsmoke.</span>
        </a>
      </>
    )}

    <span class="stamp" aria-hidden="true">{profile ? "OPEN SEASON" : "REWARD: A CLEAN BACKLOG"}</span>
  </section>

  <p class="coming reveal r3">— more duels comin' to town —</p>
</Layout>

<script>
  // Back from /api/auth/callback: a fresh sign-in starts with a fresh game,
  // same as the token flow below. Drop ?login= so a reload doesn't repeat it.
  const login = new URL(location.href).searchParams.get("login");
  if (login) {
    if (login === "ok") {
      try { localStorage.removeItem("ddr_progress"); } catch {}
    }
    history.replaceState(null, "", "/");
  }

  const signin = document.getElementById("signin");
  signin?.addEventListener("click", async () => {
    const token = (document.getElementById("token") as HTMLInputElement).value.trim();
    const err = document.getElementById("login-error")!;
    err.textContent = "";
    if (!token) { err.textContent = "Paste a token first, partner."; return; }
    (signin as HTMLButtonElement).disabled = true;
    try {
      const res = await fetch("/api/auth", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ token }),
      });
      if (!res.ok) throw new Error((await res.json()).error || "Sign-in failed");
      try { localStorage.removeItem("ddr_progress"); } catch {}
      window.location.href = "/";
    } catch (e: any) {
      err.textContent = String(e.message || e);
      (signin as HTMLButtonElement).disabled = false;
    }
  });

  const countEl = document.getElementById("bm-count");
  if (countEl) {
    // Lightweight count endpoint: one daily.dev call, not a full paginated load.
    fetch("/api/bookmarks/count")
      .then((r) => {
        if (!r.ok) throw new Error(`count failed: ${r.status}`);
        return r.json();
      })
      .then((d) => {
        const n = d.count ?? 0;
        countEl.textContent = d.exact ? String(n) : `${n}+`;
      })
      .catch(() => { countEl.textContent = "?"; });
  }
</script>

<style>
  .kicker {
    font-family: var(--font-type);
    letter-spacing: 0.35em;
    font-size: 0.7rem;
    color: var(--brass);
    margin: 0 0 0.4rem;
  }

  /* ---- the bounty poster ---- */
  .notice {
    position: relative;
    width: 100%;
    max-width: 480px;
    margin-top: 0.4rem;
    padding: 2.2rem 2rem 2.4rem;
    text-align: center;
    color: var(--ink);
    /* aged paper: warm center, foxed edges, a faint fold line */
    background:
      linear-gradient(90deg, transparent 49.6%, rgba(116, 96, 63, 0.10) 50%, transparent 50.4%),
      radial-gradient(ellipse at 50% 35%, var(--paper-hi) 0%, var(--paper) 62%, #d8c69c 100%);
    border-radius: 2px;
    box-shadow:
      0 0 0 1px var(--paper-edge),
      inset 0 0 40px rgba(116, 82, 30, 0.25),
      0 24px 50px rgba(0, 0, 0, 0.6);
    transform: rotate(-0.8deg);
  }
  .notice::before {
    content: "";
    position: absolute;
    inset: 10px;
    border: 3px double rgba(116, 96, 63, 0.55);
    pointer-events: none;
  }
  .nail {
    position: absolute;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #e8e2d4, #7a766c 55%, #2c2a26);
    box-shadow: 0 2px 3px rgba(0, 0, 0, 0.55);
  }
  .nail.tl { top: 16px; left: 16px; }
  .nail.tr { top: 16px; right: 16px; }
  .nail.bl { bottom: 16px; left: 16px; }
  .nail.br { bottom: 16px; right: 16px; }

  .notice-top {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 9vw, 3.6rem);
    letter-spacing: 0.14em;
    line-height: 1;
    margin: 0.2rem 0 0;
    color: var(--ink);
    text-shadow: 1px 1px 0 rgba(255, 255, 255, 0.35);
  }
  .notice-rule {
    font-family: var(--font-type);
    font-size: 0.72rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--blood);
    margin: 0.35rem 0 1.1rem;
    padding-bottom: 0.9rem;
    border-bottom: 3px double var(--ink-soft);
  }

  /* the revolver cylinder from the game, small and idling */
  .mini-cylinder {
    position: relative;
    width: 92px;
    height: 92px;
    margin: 0 auto 1rem;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 32%, #5a5a60 0%, #34343a 38%, #1c1c20 72%, #0d0d10 100%);
    border: 4px solid;
    border-color: var(--brass-hi) var(--brass) #6e4f17 var(--brass);
    box-shadow: 0 0 0 2px #0c0c0e, 0 8px 18px rgba(0, 0, 0, 0.45);
    animation: idle 14s linear infinite;
  }
  .notice:hover .mini-cylinder { animation-duration: 1.6s; }
  .mini-cylinder .h {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 17px;
    height: 17px;
    margin: -8.5px 0 0 -8.5px;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #1a1a1d, #050506);
    box-shadow: inset 0 2px 3px rgba(0, 0, 0, 0.9);
    transform: rotate(calc(var(--i) * 60deg)) translateY(-28px);
  }
  .mini-cylinder .h:first-child {
    background: radial-gradient(circle at 40% 35%, #ffe9a8, #bb8a32 58%, #6e4f17);
  }
  .mini-cylinder .hub {
    position: absolute;
    inset: 50%;
    width: 20px;
    height: 20px;
    margin: -10px;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 32%, #d8d8de, #6a6a70 60%, #2a2a2e);
  }
  @keyframes idle { to { transform: rotate(360deg); } }

  .mode-name {
    font-family: var(--font-display);
    font-size: 1.45rem;
    margin: 0 0 0.5rem;
    color: var(--ink);
  }
  .pitch {
    font-size: 1.02rem;
    line-height: 1.55;
    margin: 0 auto 1.1rem;
    max-width: 34ch;
    color: #3d2f1f;
  }
  .pitch b { color: var(--blood); }

  .steps {
    list-style: none;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    padding: 0;
    margin: 0 0 1.4rem;
    font-family: var(--font-type);
    font-size: 0.74rem;
    color: var(--ink-soft);
  }
  .steps li {
    flex: 1;
    padding: 0.5rem 0.3rem;
    border: 1px dashed rgba(116, 96, 63, 0.6);
  }
  .steps span {
    display: block;
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--rust);
  }

  /* sign-in block: the official daily.dev button, framed as a ledger line */
  .ledger {
    padding-top: 1.1rem;
    border-top: 1px solid rgba(116, 96, 63, 0.4);
  }
  .ledger-label {
    font-family: var(--font-type);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 0.6rem;
  }
  .official-signin {
    display: inline-block;
    border-radius: 6px;
    box-shadow: 0 4px 0 rgba(0, 0, 0, 0.35);
    transition: transform 0.08s ease, box-shadow 0.15s ease;
  }
  .official-signin img { display: block; height: 46px; width: auto; }
  .official-signin:hover { transform: translateY(-1px); box-shadow: 0 6px 0 rgba(0, 0, 0, 0.35); }
  .official-signin:active { transform: translateY(3px); box-shadow: 0 1px 0 rgba(0, 0, 0, 0.35); }
  .official-signin:focus-visible { outline: 3px solid var(--rust); outline-offset: 3px; }

  .fine {
    font-family: var(--font-type);
    font-size: 0.76rem;
    color: var(--ink-soft);
    line-height: 1.5;
    margin: 0.7rem auto 0;
    max-width: 38ch;
  }
  .fine a { color: var(--rust); font-weight: 700; }
  details.token-form summary { cursor: pointer; display: inline-block; }
  details.token-form[open] { text-align: left; }
  details.token-form[open] summary { display: block; text-align: center; }
  .token-form input { margin-top: 0.7rem; }
  .token-form button { margin-top: 0.6rem; }

  .demo-link {
    display: block;
    margin-top: 1.2rem;
    padding: 0.85rem 1rem;
    text-decoration: none;
    color: var(--ink);
    border: 2px solid var(--ink-soft);
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.18);
    transition: background 0.15s ease, transform 0.08s ease;
  }
  .demo-link:hover { background: rgba(255, 255, 255, 0.35); transform: translateY(-1px); }
  .demo-title { display: block; font-family: var(--font-display); font-size: 1.05rem; color: var(--ink); }
  .demo-sub { display: block; font-family: var(--font-type); font-size: 0.74rem; color: var(--ink-soft); margin-top: 0.15rem; }

  /* signed-in: the bounty count is the headline */
  .bounty { margin: 0 0 1.2rem; }
  .bounty b {
    display: block;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 4rem;
    line-height: 1;
    color: var(--blood);
  }
  .bounty span {
    font-family: var(--font-type);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .draw { display: block; font-size: 1.2rem; padding: 0.9rem 1.1rem; }
  .alt { font-family: var(--font-type); font-size: 0.78rem; color: var(--ink-soft); margin: 0.9rem 0 0; }
  .alt a { color: var(--rust); font-weight: 700; }

  .stamp {
    position: absolute;
    right: -12px;
    top: 8.6rem;
    transform: rotate(9deg);
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--blood);
    border: 2px solid var(--blood);
    padding: 3px 9px;
    border-radius: 3px;
    background: var(--paper-hi);
    opacity: 0.92;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
  }

  .coming {
    text-align: center;
    font-family: var(--font-type);
    color: #8c7a5a;
    font-size: 0.8rem;
    margin: 1.8rem 0 0;
  }

  /* staggered entrance */
  .reveal { animation: rise 0.7s cubic-bezier(0.16, 1, 0.3, 1) both; }
  .r1 { animation-delay: 0.05s; }
  .r2 { animation-delay: 0.2s; }
  .r3 { animation-delay: 0.35s; }
  @keyframes rise {
    from { opacity: 0; transform: translateY(22px); }
    to { opacity: 1; }
  }
  .notice.reveal { animation-name: nail-up; }
  @keyframes nail-up {
    from { opacity: 0; transform: translateY(22px) rotate(-3deg); }
    to { opacity: 1; transform: rotate(-0.8deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .mini-cylinder, .reveal { animation: none; }
  }
</style>
