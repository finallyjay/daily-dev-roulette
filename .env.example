# All variables are optional: without them a deployment only offers the
# client-side demo (`pnpm dev` also offers personal-token sign-in).

# "Sign in with daily.dev" OAuth app (daily.dev Settings → API → OAuth apps).
# Register this redirect URI on the app:
#   https://daily-dev-roulette.vercel.app/api/auth/callback
# daily.dev rejects every loopback URI (localhost, 127.0.0.1) for web apps, so
# the full flow can't complete on a local dev server. To try a branch, register
# its Vercel preview alias, e.g.
#   https://daily-dev-roulette-git-<branch>-<team>.vercel.app/api/auth/callback
DAILY_OAUTH_CLIENT_ID=
DAILY_OAUTH_CLIENT_SECRET=
